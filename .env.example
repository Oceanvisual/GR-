# Copy to .env and fill in. All variables are optional unless noted.

# --- service ---
APP_ENV=local                    # local | server
APP_PORT=8000
APP_PUBLIC_URL=                  # required when APP_ENV=server, e.g. https://npa.example.org
DATA_DIR=./data                  # /data in Docker
DATABASE_URL=                    # default: sqlite+aiosqlite:///${DATA_DIR}/gr.db

# --- auth (HTTP Basic) ---
AUTH_ENABLED=false               # false is allowed only when APP_ENV=local
AUTH_USERS=                      # login:scrypt$salt$hash,... ; generate with `uv run gr hash-password <login>`

# --- upload limits ---
MAX_UPLOAD_MB=20
MAX_PAGES=300
MAX_CHARS=1000000
MAX_UNZIPPED_MB=100

# --- LLM (OpenAI-compatible endpoint) ---
LLM_DATA_POLICY=disabled         # disabled | local_only | external_allowed
LLM_BASE_URL=                    # required unless policy is disabled
LLM_API_KEY=
LLM_LOCAL_HOSTS=localhost,127.0.0.1,ollama,vllm
LLM_MODEL_EXTRACTION=            # required unless policy is disabled
LLM_MODEL_ANALYSIS=              # required unless policy is disabled
LLM_STRUCTURED_MODE=auto         # json_schema | json_object | auto
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_CONCURRENCY=4
LLM_CACHE_ENABLED=true
LLM_MAX_OUTPUT_TOKENS=16000
LLM_PRICE_INPUT_PER_MTOK=        # for cost estimate only
LLM_PRICE_OUTPUT_PER_MTOK=

# --- processing ---
MAX_CONCURRENT_ANALYSES=2
PARSE_WORKERS=2
PARSE_TIMEOUT_S=120
SQLITE_BUSY_TIMEOUT_MS=5000

# --- OCR (local tesseract) ---
OCR_ENABLED=true
OCR_LANG=rus+eng
OCR_DPI=300
OCR_MAX_PAGES=150
OCR_PAGE_TIMEOUT_S=60
OCR_MIN_CONFIDENCE=60
OCR_CONCURRENCY=1

# --- logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console               # console | json
